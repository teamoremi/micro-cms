{
  "name": "@micro-cms/crypto-auth-ui",
  "version": "1.0.32",
  "description": "Composable Crypto Authentication Widget for Micro-CMS",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tailwindcss -i src/index.css -o dist/index.css --minify && bash ./scripts/sync-styles.sh && tsup",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.91.1",
    "bs58": "^5.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "tailwind-merge": "^2.2.1",
    "viem": "^2.7.0"
  },
  "peerDependencies": {
    "@micro-cms/core": "workspace:*",
    "@micro-cms/types": "workspace:*",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
